            "type": "grafana-postgresql-datasource",
            "uid": "garmin-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM finished_at) * 1000 AS \"Zadnji sync\",\n       CASE WHEN ok THEN 'ok' ELSE 'greške' END AS \"Status\"\nFROM garmin.sync_log WHERE finished_at IS NOT NULL ORDER BY finished_at DESC LIMIT 1"
        }
