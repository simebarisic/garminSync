          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT calendar_date AS \"Datum\", recovery AS \"Oporavak\" FROM garmin.recovery_daily\nWHERE hrv IS NOT NULL OR sleep_h IS NOT NULL OR rhr IS NOT NULL\nORDER BY calendar_date DESC LIMIT 1"
