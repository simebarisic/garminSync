# Garmin Connect Web → Settings → Personal API (prikaže se samo jednom)
GARMIN_API_KEY=

# Lozinka za garmin bazu – izmisli dugačku, NE koristi istu kao za druge servise
POSTGRES_PASSWORD=

# Lokalni port za pristup bazi s hosta (psql); bind je samo na 127.0.0.1
DB_PORT=5434

# Kada daemon povlači podatke (lokalno vrijeme) i koliko dana unazad svaki put.
# Prvo vrijeme u listi je "jutarnje" – nakon njega ide Telegram sažetak.
TZ_NAME=Europe/Zagreb
SYNC_TIMES=09:30,21:30
SYNC_DAYS=3

# Grafana (http://localhost:3034) – read-only korisnik baze + admin login za uređivanje
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3034

# Biološka dob – datum rođenja (YYYY-MM-DD). Prazno = pokušaj iz Garmin profila / Fitness Age.
BIRTH_DATE=

# Telegram (opcionalno): bot od @BotFather + tvoj chat id. Prazno = samo log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MORNING_MESSAGE=true

# Backup baze u ./backups
BACKUP_TIME=03:15
BACKUP_KEEP_DAYS=14
